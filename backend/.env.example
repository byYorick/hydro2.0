# Переменные для docker compose (backend/docker-compose.dev.yml).
# Скопируйте: cp .env.example .env  или запустите: make lan-setup
#
# IP хоста в локальной сети (телефон, другой ПК). Оставьте пустым для localhost-only.
LAN_HOST=192.168.1.116

# Dev MQTT/Postgres/Redis по умолчанию слушают только 127.0.0.1.
# Для ESP32 в LAN: MQTT_BIND_ADDR=0.0.0.0
# MQTT_BIND_ADDR=127.0.0.1
# POSTGRES_BIND_ADDR=127.0.0.1
# REDIS_BIND_ADDR=127.0.0.1

# Пароли пользователей Mosquitto (dev). Не используйте эти значения вне локальной машины.
# MQTT_HISTORY_LOGGER_PASS=logger_pass
# MQTT_MQTT_BRIDGE_PASS=bridge_pass
# MQTT_AUTOMATION_ENGINE_PASS=automation_pass
# MQTT_ESP32_NODE_PASS=esp32_pass
# Должен совпадать с mqtt.password узла, иначе node_secret_enc не расшифруется.
# NODE_SECRET_WRAP_PASSPHRASE=esp32_pass

# URL веб-приложения для браузера (nginx :8080). При LAN_HOST — подставьте свой IP.
APP_URL=http://192.168.1.116:8080
VITE_DEV_SERVER_URL=http://192.168.1.116:8080
