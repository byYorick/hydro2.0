# MQTT ACL
# history-logger — единственный сервис с широким доступом к hydro/#:
# он читает телеметрию/статусы и публикует command, config и time/response.
# Остальные учётки — только то, чем они реально пользуются.
#
# Per-node: прошивка ставит MQTT client id = node_uid.
# Строки pattern действуют на всех пользователей и подставляют %c (client id).
# Поэтому client id сервисов не должен совпадать с node_uid.

user history_logger
topic readwrite hydro/#

# mqtt-bridge только читает живой статус узла (status_probe).
user mqtt_bridge
topic read hydro/+/+/+/status
topic read hydro/+/+/+/lwt
topic read hydro/+/+/+/heartbeat
topic read hydro/+/+/+/+/telemetry
topic read hydro/gh-temp/zn-temp/+/status
topic read hydro/gh-temp/zn-temp/+/lwt
topic read hydro/gh-temp/zn-temp/+/heartbeat
topic read hydro/gh-temp/zn-temp/+/+/telemetry

# automation-engine команды не публикует: только REST history-logger.
# Учётка остаётся в passwords.txt, топиков нет.
user automation_engine

# python_service в runtime не подключается к брокеру.
user python_service

# ESP32. Зональные топики — только своего client id (node_uid).
# gh-temp — общий pre-bind namespace (сегмент там hardware_id, не node_uid).
user esp32_node
topic write hydro/node_hello
topic write hydro/time/request
topic read hydro/time/response
topic read hydro/gh-temp/zn-temp/+/config
topic read hydro/gh-temp/zn-temp/+/+/command
topic write hydro/gh-temp/zn-temp/#

pattern readwrite hydro/+/+/%c/#
