<?xml version="1.0" encoding="utf-8"?>
<!--
    Release и любой non-debug вариант: cleartext запрещён.
    Debug-сборка подменяет этот файл из src/debug/res/xml/.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
